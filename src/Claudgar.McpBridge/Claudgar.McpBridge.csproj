<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Claudgar.McpBridge</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Only the helper is trimmed. The WinForms app remains untrimmed for UI compatibility. -->
    <PublishTrimmed>true</PublishTrimmed>
    <Description>Native Claude Desktop stdio connection to Claudgar's loopback saved-character tools.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Claudgar.Core/Claudgar.Core.csproj" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>
</Project>
