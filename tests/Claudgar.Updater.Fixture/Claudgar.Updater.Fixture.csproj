<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Claudgar.Updater.Fixture</AssemblyName>
    <Product>Claudgar</Product>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Claudgar.Core/Claudgar.Core.csproj" />
    <Compile Include="../../src/Claudgar.App/Updates/**/*.cs" Link="Updates/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
